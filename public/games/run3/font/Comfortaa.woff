		<style id="wp-custom-css">
			/* Fixes */
blockquote strong,
blockquote b {
	font-weight: bold;
}

/* Adjustments */
article li {
	margin-bottom: 7px;
}

details {
	margin-bottom: 1.5em;
	padding-left: 1em;
}

details[open] {
	border-left: 1px solid #EEE;
}

details summary {
	font-size: 90%;
}

/* This used to be done automatically, but got lost in the transition. */
.sidebar li {
  list-style-type: none;
  padding: 0.1em 0;
}

.sidebar .wp-block-latest-comments .wp-block-latest-comments__comment {
	padding: 0.6em 0;
}

/* New classes */
.highlight-error {
	color: #A00;
	font-weight: bold;
}

/* Text decorations */
article a[href^="#"] {
	border-bottom-style: dashed;
}

span.info {
	border-bottom: 1px dashed #999;
}

/* Social media buttons */

.kofi-icon {
	background-color: #ff5a16;
}
.kofi-icon svg {
  background-image: url("/kofi.svg");
  background-repeat: no-repeat;
  background-size: contain;
	background-position: center;
}
.kofi-icon svg path {
	display: none;
}

/* Fonts */
@font-face {
  font-family: 'Audiowide';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(/run/2/assets/font/Audiowide_Regular.ttf) format('truetype');
}
.font-audiowide {
  font-family: "Audiowide", sans-serif;
  font-weight: 400;
  font-style: normal;
}

/* Link decorations */

/* Icons that come first can be overridden by later ones. Therefore, declare them in order from least specific to most specific. */

article a:not([href^="#"],[href^="/"], [href^="https://player03.com/"]):after {
	background-image: url(/external.svg);
}

/* article a[href^="#"]:after {
	font-size: 90%;
	content: " ⇅";
} */

article a[title]::after, span.info::after {
	font-size: 0.9em;
	content: "ⓘ";
}

@media (hover: none) {
  article a[title]:hover:after,
  span.info:hover:after {
    content: "ⓘ " attr(title);
  }
}

article a[href^="https://github.com/"]::after,
article a[href^="https://gist.github.com/"]::after {
	background-image: url(/github.svg);
}

article a[href^="https://en.wikipedia.org/"]::after {
	background-image: url(/wikipedia.ico);
}

article a:not([href^="#"],[href^="/"], [href^="https://player03.com/"], [href^="https://hhj.ypv.mybluehost.me/"]):after,
article a[href^="https://github.com/"]::after,
article a[href^="https://gist.github.com/"]::after,
article a[href^="https://en.wikipedia.org/"]::after {
	background-size: 100%;
  content: "";
	display: inline-block;
	width: 0.9em;
	height: 0.9em;
	margin-left: 0.1em;
}

article a[href^="https://haxe.org/"]::after,
article a[href^="https://api.haxe.org/"]::after,
article a[href^="https://lib.haxe.org/"]::after,
article a[href^="https://code.haxe.org/"]::after {
	background-image: url(/haxe.ico);
	background-size: 100%;
  content: "";
	display: inline-block;
	width: 0.9em;
	height: 0.9em;
	margin-left: 0.1em;
}
		</style>
		</head>

